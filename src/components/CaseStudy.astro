---
import { caseStudy } from '../content/case-study';

const { title, summary, chartCaption, scenarios, blocks } = caseStudy;

// Chart geometry, in SVG user units: a label row above each bar.
const ROW = 60;
const BAR = 24;
const BAR_TOP = 22;
const chartHeight = scenarios.length * ROW - 8;
const rows = scenarios.map((s, i) => ({ ...s, y: i * ROW }));
const chartDesc = scenarios.map((s) => `${s.label}: ${s.value}`).join('; ') + '.';
---

<section id="case-study" aria-labelledby="case-study-title">
  <div class="head">
    <span class="num" aria-hidden="true">02</span>
    <h2 id="case-study-title">{title}</h2>
  </div>
  <p class="summary">{summary}</p>

  <figure class="chart">
    <figcaption id="case-study-chart-cap">{chartCaption}</figcaption>
    <svg
      width="100%"
      height={chartHeight}
      role="img"
      aria-labelledby="case-study-chart-cap case-study-chart-desc"
    >
      <desc id="case-study-chart-desc">{chartDesc}</desc>
      {
        rows.map((r) => (
          <g>
            <text x="0" y={r.y + 14} class="label">{r.label}</text>
            <rect x="0" y={r.y + BAR_TOP} width="100%" height={BAR} rx="4" class="track" />
            <rect x="0" y={r.y + BAR_TOP} width={r.value} height={BAR} rx="4" class="bar" />
            <text x={r.value} dx="-8" y={r.y + BAR_TOP + 16.5} text-anchor="end" class="value">
              {r.value}
            </text>
          </g>
        ))
      }
    </svg>
  </figure>

  <div class="blocks">
    {
      blocks.map((b) => (
        <div class="block">
          <h3>{b.heading}</h3>
          <div>
            <p>{b.body}</p>
            {b.bullets && (
              <ul>
                {b.bullets.map((li) => (
                  <li>
                    <b>{li.lead}</b> {li.text}
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  section {
    padding: var(--s8) 0;
    border-top: 1px solid var(--line);
  }

  .head {
    display: flex;
    align-items: baseline;
    gap: var(--s3);
    margin-bottom: var(--s6);
  }

  .num {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--accent);
  }

  h2 {
    font-size: var(--fs-lede-lg);
    letter-spacing: -0.02em;
    font-weight: var(--fw-heading);
    line-height: var(--lh-snug);
  }

  .summary {
    font-size: var(--fs-summary);
    line-height: var(--lh-body);
    color: var(--muted);
    margin: calc(-1 * var(--s3)) 0 var(--s5);
    max-width: 52ch;
  }

  .chart {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--s5);
    margin-bottom: var(--s6);
  }

  .chart figcaption {
    font-size: var(--fs-body-sm);
    font-weight: var(--fw-semibold);
    margin-bottom: var(--s4);
  }

  .chart svg {
    width: 100%;
    display: block;
    overflow: visible;
  }

  .label {
    font-family: var(--font-sans);
    font-size: var(--fs-body-sm);
    fill: var(--muted);
  }

  .value {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    fill: var(--on-accent);
  }

  .track {
    fill: var(--accent-soft);
  }

  .bar {
    fill: var(--accent);
  }

  .block {
    display: grid;
    grid-template-columns: calc(var(--s9) + var(--s7)) 1fr;
    gap: var(--s5);
    padding: var(--s5) 0;
    border-top: 1px solid var(--line);
  }

  .block:first-child {
    border-top: 0;
  }

  h3 {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: var(--fw-regular);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: var(--s1);
  }

  p,
  li {
    font-size: var(--fs-md);
    line-height: var(--lh-body);
  }

  ul {
    margin-top: var(--s4);
    padding-left: 1.1em;
  }

  li {
    margin: var(--s2) 0;
    color: var(--muted);
  }

  li b {
    color: var(--text);
    font-weight: var(--fw-semibold);
  }

  @media (max-width: 640px) {
    .block {
      grid-template-columns: 1fr;
      gap: var(--s2);
    }

    .chart {
      padding: var(--s4);
    }
  }
</style>
