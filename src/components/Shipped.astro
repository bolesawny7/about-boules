---
// 01 What I've shipped: three highlight results, then Experience and Projects.
// Every string comes from src/content/profile.ts.
import { profile } from '../content/profile';

const PLACEHOLDER = 'PLACEHOLDER';

type Row = { text: string; bold: boolean }[];

/** Split `text` so the first match of each emphasis phrase renders bold. */
function emphasize(text: string, phrases: string[] = []): Row {
  const hit = phrases
    .map((p) => ({ p, i: text.indexOf(p) }))
    .filter((h) => h.i >= 0)
    .sort((a, b) => a.i - b.i)[0];
  if (!hit) return [{ text, bold: false }];
  const end = hit.i + hit.p.length;
  return [
    { text: text.slice(0, hit.i), bold: false },
    { text: hit.p, bold: true },
    { text: text.slice(end), bold: false },
  ].filter((part) => part.text);
}

const roles = profile.experience.map((role) => ({
  ...role,
  rows: role.bullets.map((b) => emphasize(b, role.emphasis)),
}));

const projects = profile.projects.map((p) => {
  const rows: Row[] = [emphasize(p.description, p.emphasis)];
  // A part Boules has not written yet stays out of the page.
  if (p.myPart && p.myPart !== PLACEHOLDER) rows.push([{ text: p.myPart, bold: false }]);
  return { ...p, rows };
});
---

<section id="shipped" class="block" aria-labelledby="shipped-title">
  <div class="sec-head">
    <span class="num" aria-hidden="true">01</span>
    <h2 id="shipped-title">What I've shipped</h2>
  </div>

  <ul class="highlights">
    {
      profile.highlights.map((h) => (
        <li class="hl">
          <p class="big">{h.stat}</p>
          <p class="what">{h.what}</p>
          <p class="where">{h.where}</p>
        </li>
      ))
    }
  </ul>

  <h3 class="sub">Experience</h3>
  {
    roles.map((role) => (
      <article class="card">
        <div class="card-head">
          <h4 class="role">
            {role.title} <span>· {role.company}</span>
          </h4>
          <span class="dates">
            {role.dates} · {role.location}
          </span>
        </div>
        <ul class="res">
          {role.rows.map((r) => (
            <li>{r.map((part) => (part.bold ? <b>{part.text}</b> : part.text))}</li>
          ))}
        </ul>
      </article>
    ))
  }

  <h3 class="sub">Projects</h3>
  {
    projects.map((p) => (
      <article class="card">
        <div class="card-head">
          <h4 class="role">
            {p.name} <span>· {p.note}</span>
          </h4>
        </div>
        <ul class="res">
          {p.rows.map((r) => (
            <li>{r.map((part) => (part.bold ? <b>{part.text}</b> : part.text))}</li>
          ))}
        </ul>
      </article>
    ))
  }
</section>

<style>
