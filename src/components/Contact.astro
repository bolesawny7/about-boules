---
import { profile } from '../content/profile';

const label = (url: string) =>
  url.startsWith('github.com') ? 'GitHub' : url.startsWith('linkedin.com') ? 'LinkedIn' : 'Old portfolio';

// Availability comes from the sourced location:
// "open to remote, works as a contractor, no visa needed".
const [, , remote, ...terms] = profile.location.split(', ');
const availability = [remote, terms.join(', ')].filter(Boolean).join('; ');
const availabilityText = availability.charAt(0).toUpperCase() + availability.slice(1) + '.';
---

<section id="contact" aria-labelledby="contact-title">
  <h2 id="contact-title">Contact</h2>
  <ul class="links">
    <li>
      <span class="k">Email</span>
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
    </li>
    {
      profile.links.map((link) => (
        <li>
          <span class="k">{label(link.url)}</span>
          <a href={`https://${link.url}`}>{link.url}</a>
        </li>
      ))
    }
  </ul>
  <p class="avail">{availabilityText}</p>
</section>

<style>
  section {
    padding: var(--s8) 0 0;
    border-top: 1px solid var(--line);
  }

  h2 {
    margin-bottom: var(--s6);
    font-size: var(--fs-h2);
    letter-spacing: -0.02em;
    font-weight: var(--fw-heading);
  }

  .links {
    list-style: none;
  }

  .links li {
    display: grid;
    grid-template-columns: 14ch 1fr;
    gap: var(--s4);
    align-items: center;
    border-top: 1px dashed var(--line);
    font-size: var(--fs-body);
  }

  .links li:first-child {
    border-top: 0;
  }

  .k {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--muted);
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: calc(var(--s7) - var(--s1)); /* 44px target */
    color: var(--accent);
    text-underline-offset: var(--s1);
    overflow-wrap: anywhere;
  }

  .links a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .avail {
    margin-top: var(--s5);
    font-size: var(--fs-md);
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .links li {
      grid-template-columns: 1fr;
      gap: 0;
      padding-top: var(--s2);
    }
  }
</style>
